# Pakhi — runtime configuration template
# ---------------------------------------------------------------------------
# HOW TO USE:  cp .env.example .env   then fill in REAL values in .env only.
# .env is gitignored and NEVER committed. Only this .env.example (placeholders)
# is tracked. Live cloud credentials stay on your machine / in GitHub Actions
# Secrets — never paste them into a committed file.
# ---------------------------------------------------------------------------

# --- Postgres (Neon or Supabase) -------------------------------------------
# Neon (recommended): https://neon.tech → Dashboard → Connection string
# Supabase:           https://supabase.com → Project Settings → Database
PAKHI_DB_READ_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@YOUR_HOST/YOUR_DB?sslmode=require
PAKHI_DB_WRITE_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@YOUR_HOST/YOUR_DB?sslmode=require
# Supabase pooler (optional, port 6543):
# PAKHI_DB_READ_URL=postgresql+psycopg://postgres.REF:YOUR_DB_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?prepare_threshold=0&sslmode=require

# --- Redis (rate limiting; fail-closed when unreachable) -------------------
PAKHI_REDIS_URL=rediss://:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST.upstash.io:6379
PAKHI_WORKERS=1

# --- API / WS-4 production posture -----------------------------------------
PAKHI_WS4_ENABLED=1
PAKHI_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
PAKHI_JWT_ISSUER=pakhi
PAKHI_API_KEYS=op_key_1,op_key_2
PAKHI_CORS_ORIGINS=https://your-frontend.example.com
PAKHI_LOG_LEVEL=INFO

# --- Stripe (webhook signature verification only, in the open-source API) --
STRIPE_WEBHOOK_SECRET=whsec_replace_me
